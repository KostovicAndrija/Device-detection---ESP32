{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=device_detection;Username=postgres;Password=postgres"
  },
  "Hashing": {
    "Salt": "device-detection-salt",
    "Pepper": "device-detection-pepper"
  },
  "Jwt": {
    "Issuer": "device-detection-api",
    "Audience": "device-detection-clients",
    "SigningKey": "device-detection-super-secret-signing-key-minimum-32-characters",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "DevelopmentUser": {
    "Username": "admin",
    "Password": "admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Localization": {
    "WindowSeconds": 15,
    "Sensors": [
      { "Id": "S1", "X": 0, "Y": 0 },
      { "Id": "S2", "X": 8, "Y": 0 },
      { "Id": "S3", "X": 4, "Y": 6 }
    ]
  },
  "Retention": {
    "ObservationHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
